<Window x:Class="Flappybird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flappybird"
        mc:Ignorable="d"
        Title="Flappy Bird" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="Bird_path">

            <TextBlock x:Name="txbl_GameTitle" Text="Flappy Bird Game" Canvas.Left="170" Canvas.Top="100" FontSize="60"/>
            <Button x:Name="btn_start" Content="Start" Canvas.Top="250" Canvas.Left="350" Width="100" Height="50" Click="btn_start_Click" />
            <Image x:Name="lb_Bird" Height="40" Width="40" Source="/bird.png" Stretch="Uniform" Canvas.Left="50" Canvas.Top="50" KeyDown="lb_Bird_KeyDown" Focusable="True" RenderTransformOrigin="0.5,0.5" Visibility="Hidden" FocusVisualStyle="{x:Null}">
                <Image.RenderTransform>
                    <TransformGroup >
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform x:Name="bird_rotation" Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>
        
        <Canvas x:Name="Pipe_path">


        </Canvas>
    </Grid>
</Window>
